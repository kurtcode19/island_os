rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().get('role', '') == role;
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() && 
        getUserData().get('role', '') == 'BUSINESS' && 
        getUserData().get('businessId', '') == businessId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || hasRole('LGU');
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || hasRole('LGU');
      allow delete: if hasRole('LGU');
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.touristUid == request.auth.uid ||
        hasRole('LGU') ||
        isBusinessOwner(resource.data.businessId)
      );
      allow create: if isAuthenticated() && request.resource.data.touristUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.touristUid == request.auth.uid ||
        hasRole('LGU') ||
        isBusinessOwner(resource.data.businessId)
      );
      allow delete: if hasRole('LGU');
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        hasRole('LGU')
      );
      allow delete: if hasRole('LGU');
    }

    match /accommodations/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if hasRole('LGU') || isBusinessOwner(resource.data.businessId);
    }

    match /experiences/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if hasRole('LGU') || isBusinessOwner(resource.data.businessId);
    }

    match /transport/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if hasRole('LGU') || isBusinessOwner(resource.data.businessId);
    }

    match /restaurants/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if hasRole('LGU') || isBusinessOwner(resource.data.businessId);
    }

    match /passes/{uid} {
      allow read: if isOwner(uid) || hasRole('LGU');
      allow write: if isOwner(uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.touristUid == request.auth.uid;
      allow update: if hasRole('BUSINESS') || hasRole('LGU');
      allow delete: if hasRole('LGU');
    }

    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && (
        resource.data.touristUid == request.auth.uid || hasRole('LGU')
      );
      allow create: if isAuthenticated() && request.resource.data.touristUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.touristUid == request.auth.uid || hasRole('LGU')
      );
      allow delete: if hasRole('LGU');
    }

    match /audit_logs/{logId} {
      allow read: if hasRole('LGU');
      allow create: if isAuthenticated();
    }

    match /inventory_items/{itemId} {
      allow read: if isAuthenticated() && (
        hasRole('LGU') || isBusinessOwner(resource.data.businessId)
      );
      allow write: if isAuthenticated() && (
        hasRole('LGU') || isBusinessOwner(resource.data.businessId)
      );
    }

    match /manual_earnings/{earningId} {
      allow read: if hasRole('LGU') || hasRole('BUSINESS');
      allow write: if hasRole('LGU');
    }

    match /payouts/{payoutId} {
      allow read: if hasRole('LGU') || isBusinessOwner(resource.data.businessId);
      allow write: if hasRole('LGU');
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        resource.data.touristUid == request.auth.uid ||
        hasRole('LGU') ||
        isBusinessOwner(resource.data.businessId)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.touristUid == request.auth.uid ||
        hasRole('LGU') ||
        isBusinessOwner(resource.data.businessId)
      );
      allow delete: if hasRole('LGU');
    }

    match /platform_revenue/{revenueId} {
      allow read, write: if hasRole('LGU');
    }

    match /port_logs/{logId} {
      allow read: if hasRole('LGU') || isBusinessOwner(resource.data.businessId);
      allow create: if isAuthenticated();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
