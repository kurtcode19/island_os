rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().get('role', '') == role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "kurtmier123@gmail.com" || 
        getUserData().get('role', '') == 'LGU'
      );
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() && 
        getUserData().get('role', '') == 'BUSINESS' && 
        getUserData().get('businessId', '') == businessId;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }

    match /accommodations/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /experiences/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /transport/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /restaurants/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /passes/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if hasRole('BUSINESS') || hasRole('LGU');
    }

    match /incidents/{incidentId} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read: if hasRole('LGU');
      allow create: if isAuthenticated();
    }

    match /inventory_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    match /manual_earnings/{earningId} {
      allow read, write: if isAuthenticated();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
