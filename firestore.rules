rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().get('role', '') == role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "kurtmier123@gmail.com" ||
        getUserData().get('role', '') == 'LGU'
      );
    }

    function isBusinessOwner(businessId) {
      return isAuthenticated() &&
        getUserData().get('role', '') == 'BUSINESS' &&
        getUserData().get('businessId', '') == businessId;
    }

    function isBookingStakeholder() {
      return isAuthenticated() && (
        request.resource.data.touristUid == request.auth.uid ||
        resource.data.touristUid == request.auth.uid ||
        isAdmin() ||
        isBusinessOwner(resource.data.get('businessId', '')) ||
        isBusinessOwner(request.resource.data.get('businessId', ''))
      );
    }

    match /users/{userId} {
      // dininggasan BUSINESS admin can list users to grant by email
      allow read: if isOwner(userId) || isAdmin() || isBusinessOwner('dininggasan-catarman');
      allow create: if isOwner(userId);
      // ponytail: owner cannot change role/businessId — only admin can
      allow update: if isAdmin() || isBusinessOwner('dininggasan-catarman') || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'businessId'])
      );
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.touristUid == request.auth.uid ||
        isAdmin() ||
        isBusinessOwner(resource.data.get('businessId', ''))
      );
      allow create: if isAuthenticated() &&
        request.resource.data.touristUid == request.auth.uid;
      allow update: if isBookingStakeholder() && (
        isAdmin() ||
        isBusinessOwner(request.resource.data.get('businessId', '')) ||
        // tourists may move UNPAID -> PAID on their own booking only; not VERIFIED
        (
          resource.data.touristUid == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'businessId']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']) ||
            (
              resource.data.get('paymentStatus', 'UNPAID') == 'UNPAID' &&
              request.resource.data.get('paymentStatus', '') == 'PAID'
            )
          )
        )
      );
      allow delete: if isBookingStakeholder();
    }

    // public occupancy map (no PII) so tourists can see free rooms
    match /room_occupancy/{bookingId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.touristUid == request.auth.uid ||
        isAdmin() ||
        isBusinessOwner(request.resource.data.get('businessId', ''))
      );
      allow update, delete: if isAdmin() ||
        isBusinessOwner(request.resource.data.get('businessId', '')) ||
        resource.data.touristUid == request.auth.uid;
    }

    match /accommodations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experiences/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transport/{id} {
      allow read: if true;
      allow write: if isAdmin() || hasRole('BUSINESS');
    }

    match /restaurants/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if isAdmin() || isBusinessOwner(businessId);
    }

    match /passes/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || hasRole('BUSINESS');
    }

    match /incidents/{incidentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /inventory_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('BUSINESS');
    }

    match /manual_earnings/{earningId} {
      allow read: if isAdmin() || hasRole('BUSINESS');
      allow create: if isAdmin() || hasRole('BUSINESS');
      allow update, delete: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if isAdmin() || hasRole('BUSINESS');
      allow create: if isAdmin() || hasRole('BUSINESS');
      allow update, delete: if isAdmin();
    }

    match /tours/{tourId} {
      allow read: if true;
      allow create, update: if isAdmin() || hasRole('BUSINESS');
      allow delete: if isAdmin();
    }

    match /rental_vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin() || hasRole('BUSINESS');
    }

    match /payouts/{payoutId} {
      allow read: if isAdmin() || hasRole('BUSINESS');
      allow write: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /platform_revenue/{revenueId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /system/{docId} {
      // pilot config is public-read; settings writes are admin-only
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
